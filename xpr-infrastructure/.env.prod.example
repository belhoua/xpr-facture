# Gabarit des variables consommées par docker-compose.prod.yml (services
# `app` et `horizon`). Sur le VPS : `cp .env.prod.example .env.prod`, puis
# renseigner les valeurs réelles. Ce fichier N'EST PAS versionné une fois
# copié (cf. .gitignore racine).
#
# Différence structurante avec .env.example (dev) et render.yaml (Vercel) :
# ici, Nginx sert FRONT et API sous le MÊME domaine (cf. nginx/bcat.conf).
# C'est un déploiement mono-origine — pas de CORS cross-site à gérer, les
# cookies de session Sanctum sont simplement "same-site".

APP_NAME=BCAT
APP_ENV=production
APP_DEBUG=false
# Domaine réel du VPS, schéma https.
APP_URL=https://votre-domaine.ma

# Générée en local : php artisan key:generate --show
APP_KEY=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- PostgreSQL (service `postgres` du compose) -----------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bcat
# Propriétaire du schéma (migrations). Doit correspondre à POSTGRES_USER /
# POSTGRES_PASSWORD lus par le service postgres dans docker-compose.prod.yml.
DB_OWNER_USERNAME=xpr_owner
DB_OWNER_PASSWORD=
DB_USERNAME=xpr_owner
DB_PASSWORD=
# Rôle applicatif SANS BYPASSRLS (cf. CLAUDE.md §15) — à câbler ici une fois
# P0-09 terminé ; en attendant DB_USERNAME reste sur xpr_owner comme en dev.

# --- Redis (service `redis` du compose) -------------------------------------
# predis, PAS phpredis : le Dockerfile de production (FrankenPHP) n'installe
# pas l'extension C — c'est délibéré, pour rester compatible Render sans
# changement d'image. predis est pur PHP, déjà dans composer.json.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# E-mails autorisés à consulter /horizon (cf. app/Providers/HorizonServiceProvider.php).
# Vide = personne n'y accède.
HORIZON_ADMIN_EMAILS=admin@bcat.ma

# Domaine fixe (contrairement au dev/Vercel où SESSION_DOMAIN=null) : un seul
# domaine sert tout, TLS terminé par Nginx-hôte.
SESSION_DOMAIN=votre-domaine.ma
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# --- Génération PDF (service `gotenberg` du compose) ------------------------
GOTENBERG_URL=http://gotenberg:3000

# --- Front / Sanctum ---------------------------------------------------------
# Même domaine que APP_URL puisque Nginx sert les deux : à renseigner SANS
# schéma pour SANCTUM_STATEFUL_DOMAINS.
FRONTEND_URL=https://votre-domaine.ma
SANCTUM_STATEFUL_DOMAINS=votre-domaine.ma

# --- Journalisation -----------------------------------------------------------
# stderr : `docker compose logs` les capture. storage/logs vivrait dans le
# volume laravel_storage, jamais purgé — stderr évite l'accumulation.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- E-mail --------------------------------------------------------------------
# À remplacer par un SMTP réel avant mise à disposition d'utilisateurs — le
# parcours d'inscription envoie les identifiants par e-mail (cf. render.yaml).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@votre-domaine.ma
MAIL_FROM_NAME=BCAT

# --- Compte d'amorçage (AdminSeeder, rejoué par l'entrypoint) ----------------
XPR_ADMIN_EMAIL=admin@bcat.ma
XPR_ADMIN_NAME=Administrateur
XPR_ADMIN_COMPANY=BCAT
XPR_ADMIN_LEGAL_FORM=sarl
# OBLIGATOIRE — le seeder refuse de créer le compte tant que vide (cf. .env.example).
XPR_ADMIN_PASSWORD=

# Jamais true en production : consomme de la vraie numérotation légale.
XPR_DEMO_DATA_ON_SIGNUP=false
