APP_NAME="XPR Facture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL via xpr-infrastructure/docker-compose.yml.
# ATTENTION : les hôtes ci-dessous sont des NOMS DE SERVICE Compose, car le
# Makefile exécute artisan DANS le conteneur php. Si vous lancez artisan
# directement depuis l'hôte, remplacez-les par 127.0.0.1 (ports publiés).
# Deux rôles PostgreSQL existent : xpr_owner (migrations, propriétaire du
# schéma) et xpr_app (exécution, SANS BYPASSRLS — c'est lui qui rend la
# Row Level Security effective). La connexion applicative xpr_app sera
# câblée en P0-09 ; en attendant le dev local utilise le rôle owner.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=xpr
DB_USERNAME=xpr_owner
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null = cookie « host-only », lié au domaine qui sert la requête. Indispensable
# derrière un proxy/tunnel (Ngrok) : un cookie Domain=localhost serait rejeté
# par le navigateur sur *.ngrok-free.app. Fonctionne aussi en local.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (docker-compose) : SMTP 1025, interface web http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@xpr.ma"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO en dev (docker-compose), S3 réel en prod. path_style obligatoire avec MinIO.
AWS_ACCESS_KEY_ID=xpr
AWS_SECRET_ACCESS_KEY=secret-minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=xpr-files
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Génération PDF (conteneur Gotenberg du docker-compose)
GOTENBERG_URL=http://gotenberg:3000

# Jeu de démonstration créé avec la première société d'un compte. Émet de vrais
# documents (numérotation comprise) : ~100 requêtes SQL dans l'inscription.
# Négligeable avec la base sur le même réseau, à couper dès qu'elle est
# distante — cf. docs/architecture/06-deploiement-serverless.md §3.4.
#
# Laisser à false hors environnement de démonstration : ces documents sont
# indiscernables de vrais une fois en base, et ils consomment la numérotation
# légale, qui ne se rembobine pas.
XPR_DEMO_DATA_ON_SIGNUP=false

# Compte d'amorçage créé par `db:seed` (AdminSeeder) : la société par défaut et
# son propriétaire, sans aucune donnée métier. Sans compte, personne ne peut se
# connecter et l'application n'a que des 401 à afficher.
#
# XPR_ADMIN_PASSWORD est OBLIGATOIRE en production — le seeder s'abstient tant
# qu'il n'est pas défini, plutôt que d'ouvrir un compte propriétaire dont le mot
# de passe serait le même partout. En développement, le défaut est "password".
XPR_ADMIN_EMAIL=admin@bcat.ma
XPR_ADMIN_NAME=Administrateur
XPR_ADMIN_COMPANY=BCAT
XPR_ADMIN_LEGAL_FORM=sarl
XPR_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# SPA Next.js (CORS, redirections, liens d'e-mails) + domaines de session Sanctum.
# SANCTUM_STATEFUL_DOMAINS accepte les jokers : *.ngrok-free.app couvre les URL
# Ngrok (qui changent à chaque lancement en offre gratuite). Le navigateur passe
# par le proxy Next → même origine, donc CORS/FRONTEND_URL n'entrent plus en jeu
# pour ce flux, mais Sanctum doit reconnaître l'Origin comme « stateful ».
#
# LES DEUX LISTES DOIVENT RESTER COHÉRENTES. Sanctum n'injecte StartSession que
# si l'Origin figure dans SANCTUM_STATEFUL_DOMAINS ; sans lui, l'authentification
# échoue sur « Session store not set on request. » — un message qui ne désigne
# pas sa cause. Le port 3001 est déclaré parce que Next y bascule tout seul
# quand 3000 est occupé.
#
# FRONTEND_URL accepte plusieurs origines séparées par des virgules : toutes
# sont autorisées en CORS, mais SEULE LA PREMIÈRE sert d'URL canonique dans les
# liens d'e-mails (cf. config/app.php).
FRONTEND_URL=http://localhost:3000,http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,127.0.0.1:3000,127.0.0.1:3001,*.ngrok-free.app,*.ngrok-free.dev,*.ngrok.app
