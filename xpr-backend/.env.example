APP_NAME="XPR Facture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL via xpr-infrastructure/docker-compose.yml.
# Deux rôles PostgreSQL existent : xpr_owner (migrations, propriétaire du
# schéma) et xpr_app (exécution, SANS BYPASSRLS — c'est lui qui rend la
# Row Level Security effective). La connexion applicative xpr_app sera
# câblée en P0-09 ; en attendant le dev local utilise le rôle owner.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xpr
DB_USERNAME=xpr_owner
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (docker-compose) : SMTP 1025, interface web http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@xpr.ma"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO en dev (docker-compose), S3 réel en prod. path_style obligatoire avec MinIO.
AWS_ACCESS_KEY_ID=xpr
AWS_SECRET_ACCESS_KEY=secret-minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=xpr-files
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Génération PDF (conteneur Gotenberg du docker-compose)
GOTENBERG_URL=http://127.0.0.1:3300

VITE_APP_NAME="${APP_NAME}"

# SPA Next.js (CORS, redirections, liens d'e-mails) + domaines de session Sanctum
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
