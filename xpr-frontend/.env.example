# Cible du reverse-proxy Next (variable SERVEUR, jamais exposée au navigateur).
# Next relaie /api/* et /sanctum/* vers cette origine (cf. next.config.ts).
BACKEND_ORIGIN=http://localhost:8080

# Override du client API navigateur. Laisser VIDE en temps normal : le client
# utilise des chemins relatifs (/api/v1, /sanctum/...) qui passent par le proxy
# ci-dessus. Même origine → pas de CORS, front joignable derrière Ngrok.
# Ne renseigner une URL absolue que pour appeler un backend distant sans proxy.
NEXT_PUBLIC_BACKEND_URL=
