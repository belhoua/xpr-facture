{
  "version": 2,
  "buildCommand": "cd xpr-backend && composer install --no-dev --prefer-dist --optimize-autoloader",
  "builds": [
    {
      "src": "xpr-backend/api/index.php",
      "use": "vercel-php@0.7.2"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "xpr-backend/api/index.php"
    }
  ]
}